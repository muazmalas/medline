APP_NAME=MedLine
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
MEDLINE_ENFORCE_HTTPS=false
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
CORS_SUPPORTS_CREDENTIALS=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medline
DB_USERNAME=root
DB_PASSWORD=
# Optional for approved non-local staging seeds; never commit the value.
# MEDLINE_SEED_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Localhost realtime notifications. Reverb runs on PHP/WebSocket locally; Redis is not required.
REVERB_APP_ID=medline-local
REVERB_APP_KEY=medline-local-key
REVERB_APP_SECRET=medline-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=false

SANCTUM_TOKEN_EXPIRATION=10080
MEDLINE_REFRESH_TOKEN_EXPIRATION_DAYS=30
MEDLINE_REFRESH_COOKIE_NAME=medline_refresh

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
MEDLINE_UPLOAD_SCAN_ENABLED=false
MEDLINE_UPLOAD_SCANNER_COMMAND=clamscan
MEDLINE_POLICY_VERSION=2026-08-18
MEDLINE_IDEMPOTENCY_RETENTION_DAYS=7
MEDLINE_IDEMPOTENCY_IN_PROGRESS_TIMEOUT_SECONDS=900
MEDLINE_DATABASE_TRANSACTION_ATTEMPTS=3
MEDLINE_NOTIFICATION_ATTEMPT_RETENTION_DAYS=90
MEDLINE_DELIVERY_LOCATION_STALE_MINUTES=10
MEDLINE_CURRENCY=SYP
MEDLINE_TAX_RATE=0
MEDLINE_DELIVERY_FEE=2500
MEDLINE_DELIVERY_FEE_PER_KM=100
MEDLINE_BICYCLE_DELIVERY_FEE_PER_KM=60
MEDLINE_MOTORCYCLE_DELIVERY_FEE_PER_KM=100
MEDLINE_CAR_DELIVERY_FEE_PER_KM=140
MEDLINE_VAN_DELIVERY_FEE_PER_KM=180
MEDLINE_SUBSCRIPTION_GRACE_PERIOD_DAYS=7
MEDLINE_ANNUAL_PHARMACY_AMOUNT=12000
MEDLINE_ANNUAL_WAREHOUSE_AMOUNT=24000
