APP_NAME=MedLine
APP_ENV=production
APP_KEY=generate-a-unique-key-on-the-release-machine
APP_DEBUG=false
APP_URL=https://api.example.com
MEDLINE_ENFORCE_HTTPS=true
CORS_ALLOWED_ORIGINS=https://admin.example.com
CORS_SUPPORTS_CREDENTIALS=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medline
DB_USERNAME=medline_app
DB_PASSWORD=replace-with-a-dedicated-database-secret
# DatabaseSeeder refuses APP_ENV=production; do not configure a seed password here.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.example.com

SANCTUM_TOKEN_EXPIRATION=60
MEDLINE_REFRESH_TOKEN_EXPIRATION_DAYS=30
MEDLINE_REFRESH_COOKIE_NAME=medline_refresh

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-mail-user
MAIL_PASSWORD=replace-with-mail-secret
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

MEDLINE_NOTIFICATION_MAX_ATTEMPTS=3
MEDLINE_DELIVERY_CLAIM_TIMEOUT_MINUTES=30
MEDLINE_DELIVERY_LOCATION_STALE_MINUTES=10
MEDLINE_DELIVERY_VERIFICATION_TTL_MINUTES=10
MEDLINE_DELIVERY_VERIFICATION_RESEND_SECONDS=60
MEDLINE_DELIVERY_VERIFICATION_MAX_ATTEMPTS=5
MEDLINE_UPLOAD_SCAN_ENABLED=true
MEDLINE_UPLOAD_SCANNER_COMMAND=clamscan
MEDLINE_POLICY_VERSION=2026-08-18
MEDLINE_IDEMPOTENCY_RETENTION_DAYS=7
MEDLINE_IDEMPOTENCY_IN_PROGRESS_TIMEOUT_SECONDS=900
MEDLINE_DATABASE_TRANSACTION_ATTEMPTS=3
MEDLINE_NOTIFICATION_ATTEMPT_RETENTION_DAYS=90
MEDLINE_ANNUAL_PHARMACY_AMOUNT=replace-with-approved-annual-pharmacy-amount
MEDLINE_ANNUAL_WAREHOUSE_AMOUNT=replace-with-approved-annual-warehouse-amount
MEDLINE_FCM_ENDPOINT=https://fcm.googleapis.com/v1/projects/replace-project/messages:send
MEDLINE_FCM_BEARER_TOKEN=replace-with-fcm-oauth-token
MEDLINE_SMS_ENDPOINT=
MEDLINE_SMS_BEARER_TOKEN=
MEDLINE_MAP_PROVIDER=openstreetmap
MEDLINE_MAP_USER_AGENT=MedLine/1.0 contact@example.com
MEDLINE_MAP_GEOCODING_URL=https://nominatim.openstreetmap.org
MEDLINE_MAP_ROUTING_URL=https://router.project-osrm.org

# Configure provider-specific push, object-storage, and map credentials through
# the deployment secret manager. Never commit these values.
